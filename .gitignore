
# ==========================================
# Hand Sign Recognition V2 - .gitignore
# ==========================================

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~


# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Build and distribution
build/
dist/
*.egg-info/
.eggs/
*.egg

# Logs and temporary files
*.log
*.tmp
*.temp
tempCodeRunnerFile.py

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Type checking and linting
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
